# Plantilla de variables de entorno del backend. Copiala a .env (que git ignora) y completala.
# NUNCA pongas aca valores reales: este archivo se commitea.
# El .env local debe apuntar SIEMPRE a la base de desarrollo, nunca a la de produccion.

# "development" en local. En Render debe valer "production".
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Base local de desarrollo (ver CLAUDE.md). Fuera de produccion el backend se niega a arrancar
# si el host no es localhost / 127.0.0.1 / ::1.
DATABASE_URL=mysql://tucompra_dev:tucompra_dev@127.0.0.1:3306/tucompra_dev
# Opcionales, solo en tu maquina: hosts remotos que aceptas a proposito (separados por coma)
# y el host de produccion, que se rechaza siempre fuera de produccion.
# DB_HOSTS_PERMITIDOS=
# DB_HOST_PRODUCCION=

# Credenciales del panel de admin (solo desarrollo)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esto
SECRET_PASSW=cambiar-esto-por-un-secreto-largo-y-aleatorio

# Cloudinary: usa una cuenta de prueba o, como minimo, una carpeta distinta a la real
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# carpeta donde se guardan las imagenes; si falta se usa "tu-compra-productos" (la de produccion)
CLOUDINARY_CARPETA=tu-compra-dev

# Mercado Pago: usa el access token de PRUEBA (TEST-...), nunca el real
MP_ACCESS_TOKEN=
